# Replace every placeholder before use. Generate secrets with `openssl rand -hex 32`.
POSTGRES_DB=neilico
POSTGRES_USER=neilico
POSTGRES_PASSWORD=replace-with-a-strong-database-password

NEILICO_AUTH_JWT_SECRET=replace-with-a-long-random-secret
NEILICO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NEILICO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
NEILICO_BOOTSTRAP_DEFAULT_TENANT=default

NEILICO_SERVER_HOST=0.0.0.0
NEILICO_SERVER_PORT=8080
NEILICO_SERVER_DASHBOARD_DIR=/opt/neilico/dashboard
NEILICO_SERVER_DASHBOARD_SPA=true

NEILICO_PROXY_ENABLED=true
NEILICO_PROXY_KIND=builtin
NEILICO_PROXY_LISTEN=:8081
NEILICO_PROXY_TLS_ENABLED=false
NEILICO_PROXY_TLS_LISTEN=:8443
NEILICO_PROXY_TLS_MIN_VERSION=1.2

NEILICO_ACME_ENABLED=false
NEILICO_ACME_CHALLENGE=http-01
NEILICO_ACME_HTTP_PORT=5002
NEILICO_LOG_LEVEL=info
NEILICO_LOG_FORMAT=json
