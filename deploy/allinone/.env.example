# Replace every placeholder before use. Generate secrets with `openssl rand -hex 32`.
POSTGRES_DB=neilico
POSTGRES_USER=neilico
POSTGRES_PASSWORD=replace-with-a-strong-database-password

NEILICO_AUTH_JWT_SECRET=replace-with-a-long-random-secret
NEILICO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NEILICO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
NEILICO_BOOTSTRAP_DEFAULT_TENANT=default
# 首次登入引导 env 文件：轮换密码后原子回写（留空/不设 = 不启用回写）。
# 容器内由 compose 指向挂载点 /opt/neilico/bootstrap.env（默认值）。
# NEILICO_BOOTSTRAP_ENV_FILE=/opt/neilico/bootstrap.env

NEILICO_SERVER_HOST=0.0.0.0
NEILICO_SERVER_PORT=8080
NEILICO_SERVER_DASHBOARD_DIR=/opt/neilico/dashboard
NEILICO_SERVER_DASHBOARD_SPA=true

NEILICO_PROXY_ENABLED=true
NEILICO_PROXY_KIND=builtin
NEILICO_PROXY_LISTEN=:8081
NEILICO_PROXY_TLS_ENABLED=false
NEILICO_PROXY_TLS_LISTEN=:8443
NEILICO_PROXY_TLS_MIN_VERSION=1.2

# 下载分发目录（/downloads/{filename} 与一键安装脚本所服务的 agent 二进制/自有客户端包）。
# 单容器部署里由 compose 绑定挂载宿主 data/neilico/downloads/，放进客户端包无需重烤镜像。
# NEILICO_DOWNLOADS_DIR=/usr/local/share/neilico/downloads

NEILICO_ACME_ENABLED=false
NEILICO_ACME_CHALLENGE=http-01
NEILICO_ACME_HTTP_PORT=5002
NEILICO_LOG_LEVEL=info
NEILICO_LOG_FORMAT=json

# 「远程桌面」：自托管 RustDesk 服务端（hbbs/hbbr，由 allinone 镜像从本仓 vendored 源码自编译）。
# 控制面只读取公钥文件（id_ed25519.pub），绝不下发私钥；hbbs/hbbr 作为控制面子进程按需拉起。
# NEILICO_RD_ENABLED=true
# NEILICO_RD_ID_SERVER=192.168.1.10     # 示例：文档保留地址，部署机替换为实际 hbbs 地址
# NEILICO_RD_RELAY_SERVER=192.168.1.10  # 示例：文档保留地址，部署机替换为实际 hbbr 地址
# 密钥目录（id_ed25519 私钥 + .pub 公钥；权限 700/600）。控制面在此启动 hbbs/hbbr。
# NEILICO_RD_KEY_DIR=/var/lib/neilico/rustdesk
# 留空则从 key_dir 派生 <key_dir>/id_ed25519.pub。
# NEILICO_RD_PUBLIC_KEY_FILE=/var/lib/neilico/rustdesk/id_ed25519.pub
# 生命周期：on_demand（默认）/ always_on / off；空闲回收阈值用 Go 时长语法。
# NEILICO_RD_SERVER_MODE=on_demand
# NEILICO_RD_IDLE_TIMEOUT=10m
# NEILICO_RD_PORTS=21115,21116,21117,21118,21119
# NEILICO_RD_RELAY_PORT=21117           # hbbr 中继端口
# NEILICO_RD_UDP_PORT=21116             # hbbs 的 UDP 端口
# NEILICO_RD_RELAY_HOST=                # 非空则给 hbbs 传 -r（显式中继地址）
