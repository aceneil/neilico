# Copy to .env and replace every placeholder before production use.
# Generate secrets with: openssl rand -hex 32
COMPOSE_PROJECT_NAME=neilico-m5

POSTGRES_DB=neilico
POSTGRES_USER=neilico
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=15432

NEILICO_JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Host ports are intentionally offset because the development host already
# uses 8080, 3000, 5432, 6379 and 4222.
CONTROL_API_PORT=18080
DASHBOARD_PORT=13000
PROXY_PORT=18081
REDIS_PORT=16379
NATS_PORT=14222
RELAY_WIREGUARD_PORT=51820
RELAY_TURN_PORT=3478

# V1-R1 ACME/Pebble overlay ports. The production ACME listener defaults to
# TCP 80 inside control-api; Pebble overlay uses 5002 because the container
# runs as an unprivileged user.
ACME_HTTP_PORT=18082
PROXY_TLS_PORT=18443
PEBBLE_PORT=14000
PEBBLE_MANAGEMENT_PORT=8055

# Optional V1-R2 alert webhook. Empty selects the structured log notifier only.
NEILICO_ALERTS_WEBHOOK_URL=
NEILICO_ALERTS_EVALUATION_INTERVAL=1m
NEILICO_ALERTS_WEBHOOK_TIMEOUT=5s
NEILICO_ALERTS_WEBHOOK_RETRIES=3
