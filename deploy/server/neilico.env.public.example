# NEILICO 公网部署环境变量（复制为 neilico.env，chmod 600）
# ---------------------------------------------------------------------------
# 生成密钥：openssl rand -hex 32
# 所有 replace-* 必须替换；NEILICO_ENROLL_PUBLIC_URL 决定「接入设备」生成的
# 命令/链接里给的地址，填错设备就接不回来。
# ---------------------------------------------------------------------------

# ── 数据库（容器内 PostgreSQL）─────────────────────────────────────────────
POSTGRES_DB=neilico
POSTGRES_USER=neilico
POSTGRES_PASSWORD=replace-db-password

# ── 控制面 ────────────────────────────────────────────────────────────────
NEILICO_AUTH_JWT_SECRET=replace-64-hex-secret
NEILICO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NEILICO_BOOTSTRAP_ADMIN_PASSWORD=replace-strong-admin-password
NEILICO_BOOTSTRAP_DEFAULT_TENANT=default

# 对外访问地址（**必须是公网可达的 https 域名**）
NEILICO_ENROLL_PUBLIC_URL=https://neilico.example.com
# 接入命令里下发的 agent 镜像（公开仓库，匿名可拉）
NEILICO_ENROLL_AGENT_IMAGE=ghcr.io/aceneil/neilico-agent:latest

# 服务端监听（容器内；公网入口由 Caddy 的 80/443 承担）
NEILICO_SERVER_HOST=0.0.0.0
NEILICO_LOG_LEVEL=info
NEILICO_LOG_FORMAT=json

# ── 内置反代（域名 → 节点虚拟 IP）─────────────────────────────────────────
NEILICO_PROXY_KIND=builtin
NEILICO_PROXY_LISTEN=:8081
# TLS 由 Caddy 终止，这里不要再开
NEILICO_PROXY_TLS_LISTEN=:8443
NEILICO_PROXY_TLS_MIN_VERSION=1.2

# ── 端口转发区间（必须与 compose 的 ports 段一致）────────────────────────
NEILICO_STREAM_PORT_MIN=20000
NEILICO_STREAM_PORT_MAX=20019

# ── 自托管 RustDesk（不需要远程桌面可整段删掉）─────────────────────────────
NEILICO_RD_ID_SERVER=neilico.example.com
NEILICO_RD_RELAY_SERVER=neilico.example.com
NEILICO_RD_KEY_DIR=/var/lib/neilico/rustdesk
NEILICO_RD_SERVER_MODE=on_demand
NEILICO_RD_IDLE_TIMEOUT=10m
# 公网部署建议显式指定中继地址，避免 NAT 回环
# NEILICO_RD_RELAY_HOST=neilico.example.com:21117

# ── 告警（可选）───────────────────────────────────────────────────────────
# NEILICO_ALERTS_WEBHOOK_URL=https://hooks.example.com/xxx
