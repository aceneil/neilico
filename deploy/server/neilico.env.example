# NEILICO 服务器部署环境变量模板
# ---------------------------------------------------------------------------
# 用法：复制为 neilico.env（与 docker-compose.deploy.yml 同目录），
#       替换所有 replace-* 占位符，然后 chmod 600 neilico.env。
# 生成密钥：openssl rand -hex 32
# ---------------------------------------------------------------------------

# ── 数据库（容器内 PostgreSQL；密码只在首次初始化时使用） ──────────────────
POSTGRES_DB=neilico
POSTGRES_USER=neilico
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# ── 控制面认证 ────────────────────────────────────────────────────────────
NEILICO_AUTH_JWT_SECRET=replace-with-a-64-hex-char-secret
NEILICO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# 至少 16 位，且满足「≥3 类字符 或 长度≥32」
NEILICO_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
NEILICO_BOOTSTRAP_DEFAULT_TENANT=default

# ── 服务端口（容器内；宿主映射见 compose 的 ports） ────────────────────────
NEILICO_SERVER_PORT=8080
NEILICO_PROXY_ENABLED=true
NEILICO_PROXY_KIND=builtin
NEILICO_PROXY_LISTEN=:8081

# ── 反代 TLS（默认关闭；公网建议在前面加 Caddy/Nginx 终止 TLS） ───────────
NEILICO_PROXY_TLS_ENABLED=false
NEILICO_PROXY_TLS_LISTEN=:8443
NEILICO_PROXY_TLS_MIN_VERSION=1.2

# ── 日志 ──────────────────────────────────────────────────────────────────
NEILICO_LOG_LEVEL=info
NEILICO_LOG_FORMAT=json

# ── 端口转发区间（必须与 compose 的 ports 段一致） ─────────────────────────
NEILICO_STREAM_PORT_MIN=20000
NEILICO_STREAM_PORT_MAX=20019

# ── 自托管 RustDesk（不需要远程桌面可整段删掉/保持关闭） ───────────────────
NEILICO_RD_ENABLED=true
# 填部署机的对外地址（公网 IP 或域名）；客户端靠它连 hbbs/hbbr
NEILICO_RD_ID_SERVER=replace-with-your-server-address
NEILICO_RD_RELAY_SERVER=replace-with-your-server-address
NEILICO_RD_KEY_DIR=/var/lib/neilico/rustdesk
NEILICO_RD_SERVER_MODE=on_demand
NEILICO_RD_IDLE_TIMEOUT=10m
# 公网部署建议显式指定中继主机，避免 NAT 回环
# NEILICO_RD_RELAY_HOST=replace-with-your-server-address
